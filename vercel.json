{
  "redirects": [
    {
      "source": "/index.txt",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "missing": [{ "type": "header", "key": "rsc" }],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path*.txt",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "missing": [{ "type": "header", "key": "rsc" }],
      "destination": "/:path*",
      "permanent": false
    }
  ]
}
